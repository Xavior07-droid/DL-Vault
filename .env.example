# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# A long, random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-character-hex-string

# Optional overrides — safe defaults are used if these are left unset.
# DATABASE_PATH=/absolute/path/to/database/legacy_vault.db
# UPLOAD_DIR=/absolute/path/to/uploads
# MAX_UPLOAD_MB=10

# Set to true only on a real deployment (enables secure cookies and
# refuses to start without a real SECRET_KEY).
FLASK_ENV_PRODUCTION=false

# --- Blockchain notarization module (Phase E — not required for Phase A-D) ---
# POLYGON_AMOY_RPC_URL=
# NOTARIZATION_CONTRACT_ADDRESS=
# IPFS_API_TOKEN=
